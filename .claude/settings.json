{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "statusMessage": "Formatting & linting...",
            "timeout": 30,
            "command": "& '.\\.claude\\hooks\\format.ps1'"
          }
        ]
      }
    ]
  }
}
